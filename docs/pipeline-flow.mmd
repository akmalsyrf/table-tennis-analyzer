flowchart TD
  A["POST /analyze or web upload"] --> B["Save to uploads id.mp4"]
  B --> C["OpenCV VideoCapture"]
  C --> D{"frame_idx % frame_step == 0?"}
  D -- no --> C
  D -- yes --> E["Resize if w > max_width"]
  E --> F["detect_table_roi_frame edge-based"]
  E --> G["BallDetector.detect prev_gray + frame"]
  F --> H["ROI metadata for JSON overlay"]
  G --> I{"YOLO ready?"}
  I -- yes --> J["YOLO class 32 + size filter"]
  I -- no --> K["HSV fallback"]
  J --> L["Motion blobs from absdiff"]
  K --> M["Detection or None"]
  L --> N["Score YOLO + motion or motion-only fallback"]
  N --> M
  M --> O["track_positions velocity + cooldown"]
  O --> P["compute_rallies"]
  P --> Q["AnalyzeResponse rallies only"]
  Q --> R["Write outputs stem.json track+roi"]
  Q --> S["generate_rally_hit_overlay_video"]
  Q --> T["Return JSON"]
